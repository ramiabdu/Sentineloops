APP_NAME=SentinelOps API
ENVIRONMENT=development
DEBUG=true
PORT=8000
DATABASE_URL=postgresql+psycopg://sentinelops:sentinelops@localhost:5432/sentinelops
DATABASE_ECHO=false
DATABASE_AUTO_MIGRATE=false
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SECRET_KEY=change-me-use-openssl-rand-hex-32
AUTH_TOKEN_TTL_MINUTES=60
AUTH_DEMO_EMAIL=analyst@sentinelops.local
AUTH_DEMO_DISPLAY_NAME=SentinelOps Analyst
AUTH_DEMO_ROLE=admin
